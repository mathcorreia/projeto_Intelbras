# Copy this file to .env and fill in production values.
# .env is git-ignored — never commit secrets.

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# JWT — use a strong random secret in production (min 32 chars)
JWT_SECRET=koreon-tech-dev-secret-must-be-at-least-32-chars!!

# Python → Java broker auth key
BROKER_API_KEY=koreon-broker-dev-key

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:4200

# Java admin seed account
ADMIN_EMAIL=admin@koreontech.com
ADMIN_PASSWORD=admin123
